# Export these variables in your shell; the backend does not load .env files.
META_API_KEY=
META_MODEL=muse-spark-1.3
DEMO_SCENARIO=connection_overheating
# Optional evaluation prices in the specified currency per million tokens.
# Leave both prices blank to report cost as unavailable; no prices are inferred.
META_INPUT_PRICE_PER_MILLION=
META_OUTPUT_PRICE_PER_MILLION=
META_PRICE_CURRENCY=USD
