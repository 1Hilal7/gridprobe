# Export these variables in your shell; the backend does not load .env files.
META_API_KEY=
META_MODEL=muse-spark-1.3
DEMO_SCENARIO=connection_overheating
# Optional prices per million tokens. API and evaluation default to USD 1.25/4.25.
# Leave both blank for Standard defaults; configure both to override.
META_INPUT_PRICE_PER_MILLION=
META_OUTPUT_PRICE_PER_MILLION=
META_PRICE_CURRENCY=USD
# Local development/preview origins; comma-separated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
